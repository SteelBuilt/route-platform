# Copy to .env.local for local overrides. Nothing here is required for local
# development: `npm run dev` works with no .env file at all (embedded PGlite
# database, dev email outbox, development-only secrets).

# --- App ---------------------------------------------------------------
APP_URL=http://localhost:3000

# --- Branding (all branding is configuration) ---------------------------
NEXT_PUBLIC_BRAND_PRODUCT_NAME="RouteYard by SBS"
NEXT_PUBLIC_BRAND_SHORT_NAME=RouteYard
NEXT_PUBLIC_BRAND_LEGAL_ENTITY="SteelBuilt Systems"
NEXT_PUBLIC_BRAND_LOGO_URL=
NEXT_PUBLIC_BRAND_PRIMARY_COLOR=#1d4ed8
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=support@localhost
NEXT_PUBLIC_BRAND_DOMAIN=localhost

# --- Database ----------------------------------------------------------
# Unset = local PGlite at PGLITE_DIR. Production: Neon connection string.
# DATABASE_URL=postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
PGLITE_DIR=.data/pglite

# --- Auth --------------------------------------------------------------
# Required in production. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Comma-separated emails that become platform admins when they sign up.
PLATFORM_ADMIN_EMAILS=

# --- Email (Resend) ----------------------------------------------------
# Unset in development = messages go to the dev outbox at /dev/outbox.
# Required in production.
RESEND_API_KEY=
EMAIL_FROM="RouteYard by SBS <no-reply@routeyard.steelbuiltsystems.com>"

# --- Signing / cron ----------------------------------------------------
# Required in production. Generate with: openssl rand -base64 48
APP_SIGNING_SECRET=
CRON_SECRET=
